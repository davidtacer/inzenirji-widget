{
  "name": "@inzenirji/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler d1 migrations apply DB --env dev --local && wrangler dev --env dev --port 8787 --local-upstream localhost:8787",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "deploy:dev": "wrangler deploy --env dev",
    "worker:dry-run": "wrangler deploy --env dev --dry-run --outdir dist-worker"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@inzenirji/shared": "workspace:*",
    "hono": "4.13.13",
    "worker-mailer": "1.2.1"
  },
  "devDependencies": {
    "wrangler": "4.150.0"
  }
}
