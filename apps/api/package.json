{
  "name": "@inzenirji/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/node.ts",
    "start": "tsx src/node.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "deploy:dev": "wrangler deploy --env dev",
    "worker:dry-run": "wrangler deploy --env dev --dry-run --outdir dist-worker"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@inzenirji/shared": "workspace:*",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "wrangler": "4.150.0"
  }
}
