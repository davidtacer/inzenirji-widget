// Cloudflare Worker: widget (static assets) + API (/api/*) on one origin. ADR-009.
// Only the `dev` environment is defined. Production is added by the owner's decision, never by CI on its own.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inzenirji-editor",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../widget/dist",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "env": {
    "dev": {
      "name": "inzenirji-editor-dev",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "uredi-dev.inzenirji.si", "custom_domain": true }]
    }
  }
}
