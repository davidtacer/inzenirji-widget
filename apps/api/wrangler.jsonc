// Cloudflare Worker: widget (static assets) + API (/api/*) on one origin. ADR-009, ADR-010.
// Only the `dev` environment is defined. Production is added by the owner's decision, never by CI on its own.
// Secrets (never here): SMTP_PASSWORD, ANTHROPIC_API_KEY, GITHUB_APP_ID + GITHUB_APP_PRIVATE_KEY (TASK-014; optional
// fallback GITHUB_TOKEN) — Cloudflare dashboard → Worker →
// Settings → Variables and Secrets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inzenirji-editor",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../widget/dist",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "env": {
    "dev": {
      "name": "inzenirji-editor-dev",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "uredi-dev.inzenirji.si", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "inzenirji-editor-dev",
          "database_id": "0cbe9b52-ff01-40d8-a348-cb54b05def54",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "MAIL_TRANSPORT": "smtp",
        "SMTP_HOST": "mail.datavallis.com",
        "SMTP_PORT": "465",
        "SMTP_USER": "hello@inzenirji.si",
        "MAIL_FROM": "hello@inzenirji.si",
        "MAIL_FROM_NAME": "Inženirji.si",
        "EDIT_MODEL": "claude-sonnet-5-5",
        "USD_TO_EUR": "0.92",
        "PRICE_MARGIN": "1"
      }
    }
  }
}
